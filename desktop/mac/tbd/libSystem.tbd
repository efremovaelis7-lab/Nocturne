--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64-macos ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1
compatibility-version: 1
exports:
  - targets:         [ x86_64-macos, arm64-macos ]
    symbols:         [ dyld_stub_binder, _strcmp, _strncmp, _strlen, _snprintf, _getpid, _usleep, _getenv, _memset, _memcpy, _memmove, _bzero, _exit, _strstr ]
...
